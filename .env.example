# ==========================================================================
#  KaiAI — Mẫu cấu hình môi trường
#  Sao chép file này thành `.env` rồi điền giá trị thật.
#  TUYỆT ĐỐI không commit `.env` lên Git.
# ==========================================================================

# --------------------------------------------------------------------------
# BẮT BUỘC
# --------------------------------------------------------------------------
# Token bot lấy tại https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# (tuỳ chọn) ID owner bổ sung; nhiều ID thì cách nhau bằng dấu phẩy.
# Nếu để trống, Discord application owner vẫn được nhận diện bởi discord.py.
BOT_OWNER_ID=
# (tuỳ chọn) Bổ sung thêm owner mà không cần sửa BOT_OWNER_ID
BOT_OWNER_IDS=

# --------------------------------------------------------------------------
# AI (OpenAI) — bỏ trống nếu không dùng
# --------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Số yêu cầu AI chạy song song tối đa (1–8)
AI_CONCURRENCY=3
AI_USER_TOKEN_BUDGET=40000
AI_GLOBAL_TOKEN_BUDGET=4000000
AI_BUDGET_WINDOW=3600

# Lịch tự động do AI tạo (!datlich) — 1 = bật, 0/off = tắt hoàn toàn.
# Tắt khi chưa muốn bot tự động thao tác tiền theo lịch.
AI_SCHEDULER=1

# Google Gemini — provider DỰ PHÒNG khi OpenAI lỗi/rate-limit
# (hoặc provider chính nếu chỉ đặt key này, không đặt OPENAI_API_KEY)
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Gemini — mặc định gemini-3.5-flash-lite; có thể đổi sang
# gemini-flash-latest / gemini-3.8-flash … (xem https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite

# --------------------------------------------------------------------------
# HỆ THỐNG
# --------------------------------------------------------------------------
# Prefix dùng cho lệnh dạng text, cách nhau bằng dấu phẩy
COMMAND_PREFIXES=!,.,?
# Kênh nhận log nội bộ của bot (0 = tắt)
LOG_CHANNEL_ID=0
# Thư mục lưu database & file log
KAI_DATA_DIR=.
# production | development
ENVIRONMENT=production
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# HEALTH SERVER (cho Render / Railway / Replit …)
# --------------------------------------------------------------------------
ENABLE_KEEP_ALIVE=true
HOST=0.0.0.0
PORT=8080

# --------------------------------------------------------------------------
# WEBSITE SESSION (tuỳ chọn)
# --------------------------------------------------------------------------
# Đặt ổn định khi website chạy nhiều worker.
DASHBOARD_SESSION_SECRET=
# Bật khi web chạy qua HTTPS (production).
DASHBOARD_COOKIE_SECURE=false
# (tuỳ chọn) Key OpenAI riêng cho trợ lý website; nếu trống sẽ dùng OPENAI_API_KEY.
WEBSITE_ASSISTANT_API_KEY=
WEBSITE_ASSISTANT_MODEL=gpt-4o-mini

# Đồng bộ Slash Command tức thì cho một guild (0 = đồng bộ toàn cầu, chậm hơn ~1h)
SYNC_GUILD_ID=0

# --------------------------------------------------------------------------
# BACKUP DỮ LIỆU (tuỳ chọn — bot vẫn chạy nếu bỏ trống)
# R2: KAI_BACKUP_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
#     KAI_BACKUP_REGION bỏ trống (tự dùng "auto")
# Backblaze B2 (miễn phí, không cần thẻ):
#     KAI_BACKUP_URL=https://s3.<REGION>.backblazeb2.com/<BUCKET>
#     (ví dụ https://s3.us-west-004.backblazeb2.com/kaiai-backup)
#     KAI_BACKUP_REGION bỏ trống (tự nhận diện từ URL) hoặc điền region,
#     ví dụ KAI_BACKUP_REGION=us-west-004
# Key/Secret lấy từ trang quản trị của nhà cung cấp (giới hạn 1 bucket).
# --------------------------------------------------------------------------
KAI_BACKUP_URL=
KAI_BACKUP_ACCESS_KEY_ID=
KAI_BACKUP_SECRET_ACCESS_KEY=
# KAI_BACKUP_REGION=          # bỏ trống = tự nhận diện (R2 → auto, B2/S3 → region thật)
# KAI_BACKUP_PREFIX=kaiai     # tiền tố khoá trên kho (mặc định kaiai)
# KAI_BACKUP_INTERVAL_MIN=30  # chu kỳ đẩy backup, phút (mặc định 30)
# KAI_BACKUP_KEEP=5           # số bản lịch sử xoay vòng (mặc định 5)
